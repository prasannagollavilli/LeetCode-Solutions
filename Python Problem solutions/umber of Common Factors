class Solution(object):
    def commonFactors(self, a, b):
        k=0
        if a==b:
            for i in range(1,a+1):
                if a%i==0:
                    k=k+1
            return k
        else:
            mi=min(a,b)
            c=0
            for i in range(1,mi+1):
                if a%i==0 and b%i==0:
                    c=c+1
            return c
        